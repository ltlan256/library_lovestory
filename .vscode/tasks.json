{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译图书馆程序",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-g",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Wshadow",
        "-Wformat=2",
        "src/main.c",
        "src/book.c",
        "src/user.c",
        "src/loan.c",
        "src/utils.c",
        "-o",
        "build/library.exe",
        "-lwinmm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "dependsOn": "创建构建目录"
    },
    {
      "label": "创建构建目录",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path 'build' | Out-Null"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
