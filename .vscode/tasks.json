{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译图书馆程序",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/console/scripts/build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/console"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "linux": {
        "command": "make",
        "args": []
      },
      "osx": {
        "command": "make",
        "args": []
      }
    }
  ]
}
